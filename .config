# ==========================================
# 1. 核心硬件与目标设备 (JDCloud RE-CS-02)
# ==========================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# ==========================================
# 2. 基础系统与中文语言界面
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y

# ==========================================
# 3. 核心需求：多线负载与 DDNS
# ==========================================
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y

# ==========================================
# 4. 网络加速与代理功能 (核心插件)
# ==========================================
CONFIG_PACKAGE_luci-app-homeproxy=y          # 强大的代理工具
CONFIG_PACKAGE_luci-app-turboacc=y           # 网络加速(流量分载/BBR)
CONFIG_PACKAGE_luci-app-sqm=y                # 流量整形/防抖动
CONFIG_PACKAGE_luci-app-firewall=y           # 防火墙管理界面
CONFIG_PACKAGE_luci-app-upnp=y               # 自动端口转发

# ==========================================
# 5. 远程组网与网络测试
# ==========================================
CONFIG_PACKAGE_luci-app-tailscale=y          # 异地组网
CONFIG_PACKAGE_luci-app-wolplus=y            # 增强型网络唤醒
CONFIG_PACKAGE_luci-app-ttyd=y               # 网页端终端
CONFIG_PACKAGE_luci-app-netspeedtest=y       # 网络测速工具

# ==========================================
# 6. 存储共享与系统辅助
# ==========================================
CONFIG_PACKAGE_luci-app-samba4=y             # 网络文件共享
CONFIG_PACKAGE_luci-app-diskman=y            # 磁盘分区管理
CONFIG_PACKAGE_luci-app-partexp=y            # 分区自动扩容
CONFIG_PACKAGE_luci-app-package-manager=y    # 软件包管理(网页端apk)
CONFIG_PACKAGE_luci-app-autoreboot=y         # 定时重启
CONFIG_PACKAGE_luci-app-ramfree=y            # 内存释放
CONFIG_PACKAGE_luci-app-usb-printer=y        # USB打印机服务

# ==========================================
# 7. 驱动支持 (解决你最初遇到的安装报错)
# ==========================================
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
